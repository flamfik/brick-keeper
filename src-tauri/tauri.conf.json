{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brick Keeper",
  "version": "1.0.0-beta",
  "identifier": "com.flamfik.brickkeeper",
  "build": {
    "beforeDevCommand": "node tools/server.mjs",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "node tools/build-tauri.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Brick Keeper",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../icons/app-icon-192.png",
      "../icons/app-icon-512.png"
    ]
  }
}
