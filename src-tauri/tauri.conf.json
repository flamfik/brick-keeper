{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brick Keeper",
  "version": "1.0.0-rc",
  "identifier": "com.flamfik.brickkeeper",
  "build": {
    "beforeDevCommand": "node tools/server.mjs",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "node tools/build-tauri.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Brick Keeper",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Brick Keeper contributors",
    "shortDescription": "Standalone LEGO brick collection organizer",
    "longDescription": "Brick Keeper is a standalone LEGO brick collection organizer with local SQLite storage.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
